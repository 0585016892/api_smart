# SERVER
NODE_ENV=development
PORT=12005

# DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_face_security
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# FILE
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# SECURITY
BCRYPT_ROUNDS=12